// A named calendar a user files events under (e.g. "Personal", "Work",
// "Team") — mirrors Google/Outlook's multi-calendar-per-user model. Every
// CalendarEvent belongs to exactly one Calendar.
model Calendar {
  id             Int      @id @default(autoincrement())
  sequenceId     Int?
  name           String
  color          String   @default("#3b82f6")
  isEnabled      Boolean  @default(true)
  ownerId        Int
  organizationId Int?
  createdById    Int
  updatedById    Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner        User          @relation("CalendarOwner", fields: [ownerId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  createdBy    User          @relation("CalendarCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?         @relation("CalendarUpdatedBy", fields: [updatedById], references: [id])

  events CalendarEvent[]

  @@index([ownerId])
  @@index([organizationId])
  @@unique([organizationId, sequenceId])
  @@map("calendars")
}

enum RecurrenceFrequency {
  daily
  weekly
  monthly
  yearly
}

// A structured RRULE-equivalent (not a raw iCalendar RRULE string) — one row
// per recurring CalendarEvent (1:1, FK lives on CalendarEvent.recurrenceId).
// This only stores the pattern; expanding it into individual occurrence
// instances for a given date range is application logic for a later phase,
// not something modeled here.
model RecurringRule {
  id        Int                 @id @default(autoincrement())
  frequency RecurrenceFrequency
  interval  Int                 @default(1)
  // 0 (Sun) – 6 (Sat); only meaningful for weekly frequency, e.g. [1, 3, 5]
  // = every Mon/Wed/Fri. Empty means "same weekday as the event's start".
  byWeekday Int[]               @default([])
  // Recurrence ends when EITHER is reached; both null = never ends.
  count     Int?
  until     DateTime?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  event CalendarEvent?

  @@map("recurring_rules")
}

enum GuestRsvpStatus {
  pending
  accepted
  declined
  tentative
}

// An invited person — `userId` is set when the guest is a registered user of
// this app, null for an external invitee known only by email. `email` is
// always present (even for internal users, captured at invite time) since
// that's what an external guest is actually identified/contacted by.
model Guest {
  id          Int             @id @default(autoincrement())
  eventId     Int
  userId      Int?
  email       String
  name        String?
  rsvp        GuestRsvpStatus @default(pending)
  invitedAt   DateTime        @default(now())
  respondedAt DateTime?

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User?         @relation("GuestUser", fields: [userId], references: [id])

  @@unique([eventId, email])
  @@index([eventId])
  @@map("event_guests")
}

enum ReminderMethod {
  notification
  email
}

model EventReminder {
  id            Int            @id @default(autoincrement())
  eventId       Int
  method        ReminderMethod @default(notification)
  minutesBefore Int            @default(10)
  createdAt     DateTime       @default(now())

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_reminders")
}

enum EventVisibility {
  standard
  private
  public
}

enum EventBusyStatus {
  busy
  free
}

enum CalendarEventStatus {
  confirmed
  // Set (never deleted) when the ProjectItem meeting link this event was
  // auto-created from gets removed — keeps the event visible on the
  // calendar as an explicit cancellation rather than silently disappearing.
  cancelled
}

model CalendarEvent {
  id             Int              @id @default(autoincrement())
  sequenceId     Int?
  organizationId Int?
  title          String
  description    String           @default("")
  location       String?
  start          DateTime
  end            DateTime
  allDay         Boolean          @default(false)
  // Per-event color override — falls back to the category's color (if set)
  // in the UI when null, same "override else inherit" idea as
  // User.sidebarTextColor falling back to the active theme's default.
  color          String?
  // Shared with Project/Metric — the org's own Department/Category taxonomy,
  // not a calendar-specific one (see git history for the earlier separate
  // CalendarCategory model this replaced).
  departmentId   Int?
  categoryId     Int?
  ownerId        Int
  calendarId     Int
  // Same scalar-field shape (not a relation) as ProjectItem's meeting-link
  // fields — only one link per event, so a join table would be overkill.
  meetingLinkUrl      String?
  meetingLinkTitle    String?
  meetingLinkPlatform MeetingPlatform?
  visibility     EventVisibility  @default(standard)
  busyStatus     EventBusyStatus  @default(busy)
  status         CalendarEventStatus @default(confirmed)
  recurrenceId   Int?             @unique
  // Set only for events auto-created/synced from a ProjectItem's meeting
  // link (see backend/services/meetingLinkCalendarSync.service.ts) — @unique
  // since a given task has at most one pasted link, and therefore at most
  // one mirrored event, at any time. Cascades so deleting the task cleans
  // up its auto-created event rather than leaving an orphan row.
  sourceProjectItemId Int?        @unique
  createdById    Int
  updatedById    Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization?     @relation(fields: [organizationId], references: [id])
  department   Department?       @relation(fields: [departmentId], references: [id])
  category     Category?         @relation(fields: [categoryId], references: [id])
  owner        User              @relation("CalendarEventOwner", fields: [ownerId], references: [id])
  calendar     Calendar          @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  recurrence   RecurringRule?    @relation(fields: [recurrenceId], references: [id])
  sourceProjectItem ProjectItem? @relation(fields: [sourceProjectItemId], references: [id], onDelete: Cascade)
  createdBy    User              @relation("CalendarEventCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?             @relation("CalendarEventUpdatedBy", fields: [updatedById], references: [id])

  guests      Guest[]
  attachments Attachment[]
  reminders   EventReminder[]

  // A recurring master's per-occurrence overrides/skips (see EventException).
  exceptions EventException[] @relation("EventExceptionMaster")
  // Set only when this CalendarEvent row is itself an occurrence override
  // (i.e. reachable only via some EventException.overrideEventId) — never
  // a standalone event a client should hit through the generic /:eventId
  // routes directly.
  exceptionOverrideFor EventException? @relation("EventExceptionOverride")

  @@index([organizationId])
  @@index([calendarId])
  @@index([departmentId])
  @@index([categoryId])
  @@index([ownerId, start])
  @@unique([organizationId, sequenceId])
  @@map("calendar_events")
}

enum ExceptionAction {
  skip
  modified
}

// A single-occurrence exception to a recurring CalendarEvent's pattern.
// `originalStart` identifies which generated occurrence slot this overrides
// (see backend/utils/recurrence.ts), independent of where an edit may move
// it. `action: skip` removes that occurrence from generation output outright
// (overrideEventId stays null). `action: modified` points at a second, full
// CalendarEvent row (own title/time/guests/etc, recurrenceId/sequenceId both
// null) holding that occurrence's overridden data — reuses EVENT_INCLUDE and
// canAccessEvent/canEditEvent instead of re-modeling relational data as JSON.
model EventException {
  id              Int             @id @default(autoincrement())
  eventId         Int
  originalStart   DateTime
  action          ExceptionAction
  overrideEventId Int?            @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  event         CalendarEvent  @relation("EventExceptionMaster", fields: [eventId], references: [id], onDelete: Cascade)
  overrideEvent CalendarEvent? @relation("EventExceptionOverride", fields: [overrideEventId], references: [id], onDelete: Cascade)

  @@unique([eventId, originalStart])
  @@index([eventId])
  @@map("event_exceptions")
}
