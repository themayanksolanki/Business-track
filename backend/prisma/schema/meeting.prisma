enum MeetingStatus {
  scheduled
  live
  ended
  cancelled
}

enum MeetingParticipantRole {
  host
  coHost
  attendee
}

// A hosted in-app meeting room (Google Meet-style). `calendarEventId`/
// `projectId` are optional links to a CalendarEvent/Project (Phase 3/4);
// group/DM linkage is still not modeled here yet. `roomCode` is the
// short shareable code (e.g. "abc-defg-hij") used in the `/meet/:roomCode`
// deep link. Reuses the existing CallType enum (message.prisma) instead of
// a new one, since a meeting is just a video/audio call with N participants.
model Meeting {
  id             Int           @id @default(autoincrement())
  sequenceId     Int?
  roomCode       String        @unique
  title          String?
  hostId         Int
  organizationId Int?
  callType       CallType      @default(video)
  status         MeetingStatus @default(scheduled)
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  startedAt      DateTime?
  endedAt        DateTime?
  // Optional linkage — a meeting can still stand alone (ad-hoc "New
  // meeting"). @unique since an event hosts at most one Meet Hub room.
  calendarEventId Int? @unique
  projectId       Int?
  // A group's call — not @unique, since a group can have any number of
  // meetings over time (unlike calendarEventId's one-room-per-event limit).
  groupId        Int?
  // True only when `calendarEventId` was auto-created by this meeting's own
  // creation (no existing event supplied) — lets cancelMeeting distinguish
  // "clean up the bare event nobody else uses" from "this was a real event
  // someone had before the meeting was attached to it" (which must survive
  // cancellation). False (default) for every other case, including a null
  // calendarEventId.
  calendarEventAutoCreated Boolean @default(false)
  createdById    Int
  updatedById    Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  host          User           @relation("MeetingHost", fields: [hostId], references: [id])
  organization  Organization?  @relation(fields: [organizationId], references: [id])
  calendarEvent CalendarEvent? @relation(fields: [calendarEventId], references: [id])
  project       Project?       @relation(fields: [projectId], references: [id])
  group         Group?         @relation(fields: [groupId], references: [id])
  createdBy     User           @relation("MeetingCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?          @relation("MeetingUpdatedBy", fields: [updatedById], references: [id])

  participants  MeetingParticipant[]
  guests        MeetingGuest[]
  settings      MeetingSettings?
  notifications Notification[]

  @@index([organizationId])
  @@index([hostId])
  @@index([projectId])
  @@index([groupId])
  @@unique([organizationId, sequenceId])
  @@map("meetings")
}

model MeetingParticipant {
  id        Int                    @id @default(autoincrement())
  meetingId Int
  userId    Int
  role      MeetingParticipantRole @default(attendee)
  invited   Boolean                @default(true)
  joinedAt  DateTime?
  leftAt    DateTime?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@map("meeting_participants")
}

// An unauthenticated participant — no `userId`/User row at all, unlike
// MeetingParticipant. `guestKey` is a random token the client mints on first
// join and resends on rejoin (page refresh) so the same browser session
// upserts the same row instead of spawning a new guest record every time;
// this is why it's the unique key here rather than reusing MeetingParticipant
// with a nullable userId, which would break that model's own
// @@unique([meetingId, userId]) (every guest would collide on null).
model MeetingGuest {
  id          Int       @id @default(autoincrement())
  meetingId   Int
  guestKey    String
  displayName String
  joinedAt    DateTime  @default(now())
  leftAt      DateTime?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, guestKey])
  @@index([meetingId])
  @@map("meeting_guests")
}

model MeetingSettings {
  id                  Int     @id @default(autoincrement())
  meetingId           Int     @unique
  waitingRoomEnabled  Boolean @default(false)
  allowGuestJoin      Boolean @default(true)
  // Distinct from allowGuestJoin above, which only relaxes access to "any
  // other authenticated same-org member with the link" — this instead
  // permits a fully unauthenticated visitor (see MeetingGuest) to join.
  // Defaults false: unlike allowGuestJoin, this changes a meeting's security
  // posture (a leaked/forwarded link becomes joinable by anyone, no account
  // needed), so it's opt-in per meeting rather than on by default.
  allowExternalGuests Boolean @default(false)
  muteOnEntry         Boolean @default(false)
  recordingEnabled    Boolean @default(false)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@map("meeting_settings")
}
