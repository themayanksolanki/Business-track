enum MetricStatus {
  active
  archived
  deleted
}

// Determines how a metric's daily/weekly/etc. values are decorated in the
// Bowling View's read mode (see metric-bowling.component.ts) — the actual
// unit shown (which currency, which weight unit) comes from the metric's
// own organization's Settings (Organization.currency/unit), not from the
// metric itself; this only picks which of those org-level preferences
// applies, or none for 'number'/'percentage'. No unit conversion is
// implied — the stored number is shown as-is with a label attached.
enum MetricDataType {
  number
  weight
  currency
  percentage
}

model Metric {
  id             Int          @id @default(autoincrement())
  sequenceId     Int?
  organizationId Int?
  departmentId   Int
  categoryId     Int?
  parentId       Int?
  title          String
  // CKEditor HTML — same plain-String (no @db.Text) treatment as
  // Project.detailsText/ProjectItem.description.
  notes          String       @default("")
  status         MetricStatus   @default(active)
  dataType       MetricDataType @default(number)
  // Which period axis this metric's Bowling View tracking uses — daily,
  // weekly, monthly, quarterly, and yearly are all implemented (see
  // backend/utils/metricPeriods.ts).
  frequency      MetricFrequency @default(daily)
  // Sibling position for future drag-drop reordering — not wired up to any
  // UI yet, seeded like ProjectItem's `order` (append-at-end on create).
  order          Int          @default(0)
  depth          Int          @default(0)
  startDate      DateTime?
  dueDate        DateTime?
  // Per-metric custom header labels for the Bowling "Sheet" tab's tracking
  // grid columns — keys are a subset of actual/target/lowest/medium/upper/
  // status/note, values are the display label to use instead of the
  // built-in default. Absent/omitted keys fall back to the default label.
  columnLabels   Json?
  // Freezes every field/tracking edit (Detail tab, Sheet tab, Bowling View
  // cells) for EVERYONE — including the owner/Admin who locked it — until
  // explicitly unlocked. Only the metric's own owner or an Admin may toggle
  // it (canLockMetric, metricController.ts); the toggle itself always stays
  // available to them regardless of the current lock state.
  isLocked       Boolean      @default(false)
  ownerId        Int
  createdById    Int
  updatedById    Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  department   Department    @relation(fields: [departmentId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id])
  parent       Metric?       @relation("MetricHierarchy", fields: [parentId], references: [id])
  children     Metric[]      @relation("MetricHierarchy")
  owner        User          @relation("MetricOwner", fields: [ownerId], references: [id])
  createdBy    User          @relation("MetricCreatedBy", fields: [createdById], references: [id])
  updatedBy    User?         @relation("MetricUpdatedBy", fields: [updatedById], references: [id])
  periodTotals MetricPeriodTotal[]
  attachments  Attachment[]
  // "Linked" tab (metric-form-modal) — a many-to-many, directed graph of
  // sub-metrics, separate from the parentId/children tree above (that one
  // stays single-parent, used only for Tiles View grouping). Cycle
  // prevention is enforced in metricLinkController.ts, not by the schema.
  linkedSubMetrics    MetricLink[] @relation("MetricLinkParent")
  linkedAsSubMetricOf MetricLink[] @relation("MetricLinkChild")
  // "Team" tab (metric-form-modal) — who can access/edit this metric beyond
  // the department-based default. See canAccessMetric/canEditMetric/
  // canManageMetricMembers in metricController.ts for exactly how this
  // interacts with the pre-existing department-based access (a metric with
  // zero rows here behaves identically to before this feature existed).
  members MetricMember[]

  @@index([organizationId])
  @@index([departmentId])
  @@index([categoryId])
  @@index([parentId, order])
  @@unique([organizationId, sequenceId])
  @@map("metrics")
}

// Fixed 3-value role — not a ProjectRole-style custom/org-defined table.
// Owner = Editor's full content-edit rights + can manage this list; Editor
// can edit metric content but not the Team tab; Viewer is read-only. See
// canEditMetric/canManageMetricMembers in metricController.ts.
enum MetricMemberRole {
  owner
  editor
  viewer
}

// One row per (metric, user) explicit team grant. A metric with no rows
// here behaves exactly as before this feature existed — department-based
// access stays full-edit; only an explicit `viewer` row here downgrades
// someone to read-only, and only an explicit row (any role) lets someone
// outside the metric's department see/reach it at all.
model MetricMember {
  id        Int              @id @default(autoincrement())
  metricId  Int
  userId    Int
  role      MetricMemberRole @default(editor)
  addedAt   DateTime         @default(now())
  addedById Int?

  metric  Metric @relation(fields: [metricId], references: [id], onDelete: Cascade)
  user    User   @relation("MetricMemberUser", fields: [userId], references: [id])
  addedBy User?  @relation("MetricMemberAddedBy", fields: [addedById], references: [id])

  @@unique([metricId, userId])
  @@index([metricId])
  @@map("metric_members")
}

// One directed edge: `metric` shows `subMetric` on its "Linked" tab.
// Deliberately its own table rather than an implicit Prisma M:N (like
// Tag<->ProjectItem) since each edge needs createdById/createdAt for the
// same lightweight audit trail every other "who added this" relation in
// this app carries.
model MetricLink {
  id          Int      @id @default(autoincrement())
  metricId    Int
  subMetricId Int
  createdById Int
  createdAt   DateTime @default(now())

  metric      Metric @relation("MetricLinkParent", fields: [metricId], references: [id], onDelete: Cascade)
  subMetric   Metric @relation("MetricLinkChild", fields: [subMetricId], references: [id], onDelete: Cascade)
  createdBy   User   @relation(fields: [createdById], references: [id])

  @@unique([metricId, subMetricId])
  @@index([metricId])
  @@index([subMetricId])
  @@map("metric_links")
}

// Mirrors MetricFrequency in backend/models/metricTracking.model.ts (the
// Mongoose-side type) — kept as a separate Prisma enum since it lives in a
// different datastore, not because the concept differs.
enum MetricFrequency {
  daily
  weekly
  monthly
  quarterly
  yearly
}

// SQL-side mirror of the Actual/Target totals computed in
// metricTrackingController.ts (see savePeriodDiff) — the day-level `periods`
// detail stays MongoDB-only (MetricTracking), but the aggregate totals are
// also persisted here on every save so SQL-side reporting/joins (with
// Department/Category/etc.) don't need to reach into Mongo at all.
model MetricPeriodTotal {
  id          Int             @id @default(autoincrement())
  metricId    Int
  frequency   MetricFrequency
  year        Int
  // Only meaningful for frequency == daily, same convention as the Mongo
  // model's `month` field.
  month       Int?
  actualTotal Float
  targetTotal Float
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  metric Metric @relation(fields: [metricId], references: [id], onDelete: Cascade)

  @@unique([metricId, frequency, year, month])
  @@map("metric_period_totals")
}
