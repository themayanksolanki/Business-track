enum DateFormat {
  DD_MM_YYYY
  MM_DD_YYYY
  YYYY_MM_DD
  DD_MMM_YY
}

enum TimeFormat {
  HOUR_12
  HOUR_24
}

enum SidebarTheme {
  MIDNIGHT
  CHARCOAL
  OCEAN
  FOREST
  PLUM
  DAYLIGHT
  ROSE
  SKY
  SAND
  LEMON
}

enum SidebarLogo {
  CHECK
  ROCKET
  BOLT
  STAR
  SHIELD
  DIAMOND
}

enum Currency {
  USD
  EUR
  JPY
  GBP
  CNY
  INR
}

enum MeasurementUnit {
  KG
  LB
}

model User {
  id             Int        @id @default(autoincrement())
  sequenceId     Int?
  username       String
  email          String     @unique
  password       String
  role           String
  organizationId Int?
  isActive       Boolean    @default(false)
  managerId      Int?
  teamLeadId     Int?
  profileImage   String?
  // ISO 3166-1 alpha-2 (e.g. "US", "IN") — kept separate from phoneNumber
  // rather than storing one E.164 string, since several countries share a
  // dial code (+1 alone covers the US, Canada, and various Caribbean
  // nations) and the edit UI needs to reconstruct which one was selected.
  phoneCountry   String?
  phoneNumber    String?
  // Personal display preferences (Settings > General) — unlike theme, which
  // is device-local, these follow the user across devices/sessions.
  dateFormat     DateFormat @default(MM_DD_YYYY)
  timeFormat     TimeFormat @default(HOUR_12)
  // Route path (no leading slash, e.g. "dashboard", "tasks", "team-tasks") to
  // land on after login — validated against a fixed whitelist in
  // validate.js rather than a Prisma enum, since a couple of routes (e.g.
  // "team-tasks") contain a hyphen, which Prisma enum values can't. A value
  // that's no longer valid for the user's current role (e.g. role changed
  // after it was set) is harmless — roleGuard just bounces them to /dashboard.
  defaultLandingPage String @default("dashboard")
  // Sidebar appearance (Profile > Appearance) — same cross-device-persisted
  // treatment as dateFormat/timeFormat above, not device-local like the
  // light/dark app theme. sidebarTextColor null means "use the active
  // theme's own default text color" rather than a stored override.
  sidebarTheme     SidebarTheme @default(MIDNIGHT)
  sidebarTextColor String?
  sidebarLogo      SidebarLogo  @default(CHECK)
  // Display currency (Settings > General) — same cross-device-persisted
  // treatment as dateFormat/timeFormat.
  currency         Currency     @default(USD)
  // Display measurement unit (Settings > General) — same treatment.
  unit             MeasurementUnit @default(KG)
  // Decimal places shown for numeric values (Settings > General) — plain Int
  // rather than an enum since it's a small bounded range (0-7), validated in
  // validate.ts rather than by the DB.
  decimalPoints    Int             @default(2)
  resetOtp       String?
  resetOtpExpiry DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization? @relation("UserOrganization", fields: [organizationId], references: [id])
  manager      User?         @relation("UserManager", fields: [managerId], references: [id])
  teamLead     User?         @relation("UserTeamLead", fields: [teamLeadId], references: [id])

  managedUsers User[] @relation("UserManager")
  ledUsers     User[] @relation("UserTeamLead")

  departments Department[] @relation("UserDepartments")

  // Directional self-relation: A muting B does not imply the reverse.
  mutedUsers User[] @relation("UserMutes")
  mutedBy    User[] @relation("UserMutes")

  // Reverse sides of createdBy/updatedBy/etc. relations declared on other
  // models — required by Prisma, rarely queried directly from this end.
  createdOrganizations Organization[]  @relation("OrganizationCreatedBy")
  updatedOrganizations Organization[]  @relation("OrganizationUpdatedBy")
  invitesSent          Invite[]        @relation("InviteInvitedBy")
  managerInvites       Invite[]        @relation("InviteManager")
  teamLeadInvites      Invite[]        @relation("InviteTeamLead")
  createdDepartments   Department[]    @relation("DepartmentCreatedBy")
  updatedDepartments   Department[]    @relation("DepartmentUpdatedBy")
  createdCategories    Category[]      @relation("CategoryCreatedBy")
  updatedCategories    Category[]      @relation("CategoryUpdatedBy")
  createdTags          Tag[]           @relation("TagCreatedBy")
  updatedTags          Tag[]           @relation("TagUpdatedBy")
  createdProjectRoles  ProjectRole[]   @relation("ProjectRoleCreatedBy")
  updatedProjectRoles  ProjectRole[]   @relation("ProjectRoleUpdatedBy")
  createdProjects      Project[]       @relation("ProjectCreatedBy")
  updatedProjects      Project[]       @relation("ProjectUpdatedBy")
  ownedProjects        Project[]       @relation("ProjectOwner")
  uploadedProjectPlans Project[]       @relation("ProjectPlanUploadedBy")
  projectMemberships   ProjectMember[] @relation("ProjectMemberUser")
  addedProjectMembers  ProjectMember[] @relation("ProjectMemberAddedBy")
  assignedProjectItems ProjectItem[]   @relation("ProjectItemAssignedTo")
  createdProjectItems  ProjectItem[]   @relation("ProjectItemCreatedBy")
  updatedProjectItems  ProjectItem[]   @relation("ProjectItemUpdatedBy")
  comments             Comment[]       @relation("CommentAuthor")
  uploadedAttachments  Attachment[]    @relation("AttachmentUploadedBy")
  createdTasks         Task[]          @relation("TaskCreatedBy")
  updatedTasks         Task[]          @relation("TaskUpdatedBy")
  assignedTasks        Task[]          @relation("TaskAssignedTo")
  sentMessages         Message[]       @relation("MessageSender")
  receivedMessages     Message[]       @relation("MessageReceiver")
  deletedMessagesFor   Message[]       @relation("MessageDeletedFor")
  messageReactions     MessageReaction[] @relation("MessageReactionUser")
  notifications        Notification[] @relation("NotificationRecipient")
  triggeredNotifications Notification[] @relation("NotificationActor")
  ownedMetrics         Metric[]       @relation("MetricOwner")
  createdMetrics       Metric[]       @relation("MetricCreatedBy")
  updatedMetrics       Metric[]       @relation("MetricUpdatedBy")
  ownedCalendars           Calendar[]         @relation("CalendarOwner")
  createdCalendars         Calendar[]         @relation("CalendarCreatedBy")
  updatedCalendars         Calendar[]         @relation("CalendarUpdatedBy")
  ownedCalendarEvents      CalendarEvent[]    @relation("CalendarEventOwner")
  createdCalendarEvents    CalendarEvent[]    @relation("CalendarEventCreatedBy")
  updatedCalendarEvents    CalendarEvent[]    @relation("CalendarEventUpdatedBy")
  calendarGuestInvites     Guest[]            @relation("GuestUser")
  hostedMeetings           Meeting[]          @relation("MeetingHost")
  createdMeetings          Meeting[]          @relation("MeetingCreatedBy")
  updatedMeetings          Meeting[]          @relation("MeetingUpdatedBy")
  meetingParticipations    MeetingParticipant[]
  taskApproverAssignments  TaskApprover[]     @relation("TaskApproverUser")
  taskApproverAssignedBy   TaskApprover[]     @relation("TaskApproverAssignedBy")
  approvalHistoryActions   ApprovalHistory[]  @relation("ApprovalHistoryUser")
  approvalComments         ApprovalComment[]  @relation("ApprovalCommentAuthor")
  createdGroups            Group[]            @relation("GroupCreatedBy")
  updatedGroups            Group[]            @relation("GroupUpdatedBy")
  groupMemberships         GroupMember[]      @relation("GroupMemberUser")
  addedGroupMembers        GroupMember[]      @relation("GroupMemberAddedBy")
  sentGroupMessages        GroupMessage[]     @relation("GroupMessageSender")
  deletedGroupMessagesFor  GroupMessage[]     @relation("GroupMessageDeletedFor")
  groupMessageReads        GroupMessageRead[] @relation("GroupMessageReadUser")

  @@unique([organizationId, sequenceId])
  @@map("users")
}
